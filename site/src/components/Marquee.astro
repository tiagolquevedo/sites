---
// Mural de depoimentos: corre sozinho, para quando a pessoa mexe, arrasta com o mouse
// e rola com o dedo (scroll nativo no toque). Cada linha anda num sentido.
export interface Quote {
  name: string;
  quote: string;
  meta: string;
  photo?: string;
  tag?: string;
}
interface Props { rows: Quote[][]; label?: string; class?: string }
const { rows, label = "Depoimentos", class: cls = "" } = Astro.props;
---
<div class:list={["marquee", cls]} aria-label={label}>
  {rows.map((row, r) => (
    <div class="mq" data-mq data-dir={r % 2 === 1 ? "-1" : "1"}>
      <div class="mq-track">
        {[0, 1].map((copy) =>
          row.map((c) => (
            <figure class="quote" aria-hidden={copy === 1 ? "true" : undefined}>
              <blockquote>“{c.quote}”</blockquote>
              <figcaption>
                {c.photo
                  ? <img class="quote-avatar" src={c.photo} alt="" width="36" height="36" loading="lazy" />
                  : <span class="quote-avatar" aria-hidden="true">{c.name[0]}</span>}
                <span><strong>{c.name}</strong><span>{c.meta}</span></span>
                {c.tag && <span class="quote-tag">{c.tag}</span>}
              </figcaption>
            </figure>
          ))
        )}
      </div>
    </div>
  ))}
</div>

<style is:global>
  .marquee { display: grid; gap: 14px; }
  /* A fileira não rola: o trilho anda por transform (animado na GPU), então a rolagem
     da página nunca é tocada. pan-y deixa o dedo rolar a página na vertical normalmente. */
  .mq {
    overflow: hidden; touch-action: pan-y; cursor: grab;
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  .mq.is-dragging { cursor: grabbing; user-select: none; }
  .mq.is-dragging .quote { pointer-events: none; }
  .mq-track { display: flex; gap: 14px; width: max-content; padding: 2px 0 4px; will-change: transform; }
  .quote { width: 420px; flex: none; display: flex; flex-direction: column; gap: 14px; padding: 18px 20px; border-radius: 20px; background: var(--color-surface); box-shadow: 0 0 0 1px rgb(16 24 42 / 0.06); }
  .quote blockquote { font-size: 14.5px; line-height: 1.55; color: var(--color-ink); }
  .quote figcaption { margin-top: auto; display: flex; align-items: center; gap: 10px; font-size: 13px; line-height: 1.25; }
  .quote figcaption strong { display: block; font-weight: 650; font-size: 14px; }
  .quote figcaption span > span { color: var(--color-ink-3); }
  .quote-avatar { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 12px; background: var(--color-navy); color: var(--color-yellow); font-family: var(--font-display); font-weight: 650; font-size: 15px; flex: none; object-fit: cover; }
  .quote-tag { margin-left: auto; padding: 4px 10px; border-radius: 999px; background: var(--color-paper); color: var(--color-ink-2); font-size: 12px; font-weight: 600; white-space: nowrap; }
  @media (max-width: 640px) { .quote { width: 290px; } .quote blockquote { font-size: 14px; } }
</style>

<script>
  // Cada fileira é uma animação de transform (Web Animations): o navegador anima na GPU,
  // sem JavaScript por quadro e sem mexer em rolagem. Arrastar só move o "relógio" da animação.
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canHover = matchMedia("(hover: hover)").matches;
  const SPEED = 28; // px por segundo

  document.querySelectorAll<HTMLElement>("[data-mq]").forEach((row) => {
    const track = row.firstElementChild as HTMLElement;
    const sign = Number(row.dataset.dir || 1) < 0 ? -1 : 1;
    let anim: Animation | null = null;
    let dur = 1, half = 1;
    let visible = false, hovered = false, held = false, holdTimer = 0;

    const time = () => Number(anim?.currentTime ?? 0);
    const wrapT = (t: number) => ((t % dur) + dur) % dur;
    const sync = () => {
      if (!anim) return;
      const run = !still && visible && !hovered && !held;
      if (run && anim.playState !== "running") anim.play();
      else if (!run && anim.playState === "running") anim.pause();
    };
    const build = () => {
      const w = track.scrollWidth / 2;
      if (!w || Math.abs(w - half) < 1) return;
      const frac = anim ? wrapT(time()) / dur : 0;
      anim?.cancel();
      half = w;
      dur = (half / SPEED) * 1000;
      anim = track.animate(
        [{ transform: "translate3d(0,0,0)" }, { transform: `translate3d(${-half}px,0,0)` }],
        { duration: dur, iterations: Infinity, direction: sign < 0 ? "reverse" : "normal" }
      );
      anim.currentTime = frac * dur;
      anim.pause();
      sync();
    };
    build();
    new ResizeObserver(build).observe(track);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { rootMargin: "100px" }).observe(row);

    // Segura um tempo depois de mexer e retoma de onde parou.
    const hold = (ms: number) => {
      held = true; sync();
      clearTimeout(holdTimer);
      holdTimer = window.setTimeout(() => { held = false; sync(); }, ms);
    };
    if (canHover) {
      row.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") { hovered = true; sync(); } });
      row.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") { hovered = false; sync(); } });
    }

    // Arrastar (mouse ou dedo). Movimento vertical fica com a página (touch-action: pan-y).
    let id = -1, x0 = 0, y0 = 0, t0 = 0, dragging = false, moved = false;
    row.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse" && e.button !== 0) return;
      id = e.pointerId; x0 = e.clientX; y0 = e.clientY; t0 = time(); dragging = false; moved = false;
      if (e.pointerType !== "mouse") hold(4000);
    });
    row.addEventListener("pointermove", (e) => {
      if (e.pointerId !== id || !anim) return;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (!dragging) {
        if (Math.abs(dx) < 6 || Math.abs(dx) < Math.abs(dy)) return;
        dragging = moved = true;
        row.setPointerCapture(id);
        row.classList.add("is-dragging");
        held = true; clearTimeout(holdTimer); sync();
      }
      // Dedo para a direita = conteúdo para a direita.
      anim.currentTime = wrapT(t0 - sign * (dx / half) * dur);
    });
    const end = (e: PointerEvent) => {
      if (e.pointerId !== id) return;
      id = -1;
      if (dragging) { dragging = false; row.classList.remove("is-dragging"); hold(1800); }
    };
    row.addEventListener("pointerup", end);
    row.addEventListener("pointercancel", end);
    row.addEventListener("click", (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);
  });
</script>
