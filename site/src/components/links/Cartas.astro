---
import Btn from "@/components/Btn.astro";
import SolutionIcon from "@/components/SolutionIcon.astro";
import { DESTS, dest } from "@/data/links";
const cards = DESTS.filter((d) => d.icon);
const fundador = dest("fundador");
const themes = ["yellow", "white", "navy", "soft"];
---
<section data-v="cartas" class="cartas mx-auto flex h-[100svh] w-full max-w-[480px] flex-col px-5 pb-[max(20px,env(safe-area-inset-bottom))] pt-8">
  <header class="text-center">
    <img src="/logo-navy.png" alt="Avanti" width="140" height="25" class="mx-auto h-[22px] w-auto" />
    <h1 class="mt-4 text-[2rem]">Escolha sua carta</h1>
    <p class="mt-1 text-[14px] text-ink-2">Arraste para o lado ou toque nos pontos</p>
  </header>

  <div class="deck" data-deck>
    {cards.map((d, i) => (
      <article class={`card-c t-${themes[i]}`} data-card={d.id} aria-label={d.label}>
        <span class="ico"><SolutionIcon name={d.icon!} /></span>
        <div>
          <h2 class="text-[2.2rem]">{d.label}</h2>
          <p class="mt-3 text-[1.05rem] leading-snug">{d.desc}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="dots" role="tablist" aria-label="Cartas">
    {cards.map((d, i) => <button type="button" role="tab" aria-label={d.label} data-dot={i}></button>)}
  </div>

  <div class="actions">
    {cards.map((d) => (
      d.id === "app"
        ? <Btn href={d.href} variant="yellow" icon="arrow" avanti class="w-full !h-[58px] !justify-between !pl-6 !text-[17px]" data-go={d.id} data-for={d.id} />
        : <Btn href={d.href} variant="yellow" icon="arrow" class="w-full !h-[58px] !justify-between !pl-6 !text-[17px]" data-go={d.id} data-for={d.id}>{d.cta}</Btn>
    ))}
    <Btn href={fundador.href} variant="line" icon="whatsapp" class="mt-3 w-full" data-go="fundador">{fundador.cta}</Btn>
  </div>
</section>

<style>
  .cartas { touch-action: pan-y; }
  .deck { position: relative; flex: 1; margin: 18px 0 8px; min-height: 0; }
  .card-c {
    position: absolute; inset: 0 0 10px; display: flex; flex-direction: column; justify-content: space-between;
    padding: 26px; border-radius: var(--radius-card); border: 1px solid rgb(16 24 42 / 0.12);
    box-shadow: 0 18px 30px -22px rgb(16 24 42 / 0.55);
    touch-action: pan-y; user-select: none; -webkit-user-select: none;
    transition: transform 420ms var(--ease-spring), opacity 300ms;
    will-change: transform;
  }
  .card-c.drag { transition: none; }
  .t-yellow { background: var(--color-yellow); color: var(--color-ink); }
  .t-white { background: var(--color-surface); color: var(--color-ink); }
  .t-navy { background: var(--color-navy); color: #fff; }
  .t-soft { background: var(--color-yellow-soft); color: var(--color-ink); }
  .t-navy p { color: #aeb7cc; }
  .ico { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 22px; background: rgb(255 255 255 / 0.55); }
  .t-navy .ico { background: rgb(255 255 255 / 0.1); color: var(--color-yellow); }
  .ico :global(svg) { width: 30px; height: 30px; }
  .dots { display: flex; justify-content: center; gap: 4px; margin-bottom: 10px; }
  .dots button { width: 36px; height: 30px; display: grid; place-items: center; background: none; border: 0; -webkit-tap-highlight-color: transparent; }
  .dots button::after { content: ""; width: 8px; height: 8px; border-radius: 99px; background: var(--color-line); transition: width 280ms var(--ease-spring), background 200ms; }
  .dots button.on::after { width: 24px; background: var(--color-ink); }
  .actions { position: relative; }
  .actions :global([data-for]) { display: none; }
  .actions :global([data-for].on) { display: inline-flex; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-v="cartas"]');
  if (root && document.documentElement.dataset.variant === "cartas") {
    const cards = [...root.querySelectorAll<HTMLElement>("[data-card]")];
    const dots = [...root.querySelectorAll<HTMLElement>("[data-dot]")];
    const cta = [...root.querySelectorAll<HTMLElement>("[data-for]")];
    const n = cards.length;
    let top = 0; // índice da carta de cima

    function layout() {
      cards.forEach((el, k) => {
        const pos = (k - top + n) % n;
        el.style.zIndex = String(10 - pos);
        el.style.opacity = pos > 2 ? "0" : "1";
        el.style.pointerEvents = pos === 0 ? "auto" : "none";
        el.style.transform = `translateY(${pos * 14}px) scale(${1 - pos * 0.05}) rotate(${pos ? (pos % 2 ? 2.2 : -2.2) : 0}deg)`;
      });
      dots.forEach((d, k) => d.classList.toggle("on", k === top));
      cta.forEach((c) => c.classList.toggle("on", c.dataset.for === cards[top].dataset.card));
    }
    const show = (k: number) => { top = (k + n) % n; layout(); };

    cards.forEach((el) => {
      let sx = 0, sy = 0, dx = 0, on = false, locked = false;
      el.addEventListener("pointerdown", (e) => { on = true; locked = false; sx = e.clientX; sy = e.clientY; dx = 0; });
      el.addEventListener("pointermove", (e) => {
        if (!on) return;
        const mx = e.clientX - sx, my = e.clientY - sy;
        if (!locked && Math.abs(mx) > 8 && Math.abs(mx) > Math.abs(my)) { locked = true; el.classList.add("drag"); el.setPointerCapture(e.pointerId); }
        if (!locked) return;
        dx = mx;
        el.style.transform = `translateX(${dx}px) rotate(${dx / 20}deg)`;
      });
      const end = () => {
        if (!on) return;
        on = false;
        el.classList.remove("drag");
        if (locked && Math.abs(dx) > 70) {
          el.style.transform = `translateX(${dx > 0 ? 460 : -460}px) rotate(${dx / 10}deg)`;
          el.style.opacity = "0";
          setTimeout(() => show(top + 1), 180);
        } else layout();
      };
      el.addEventListener("pointerup", end);
      el.addEventListener("pointercancel", end);
    });
    dots.forEach((d, k) => d.addEventListener("click", () => show(k)));
    layout();
  }
</script>
