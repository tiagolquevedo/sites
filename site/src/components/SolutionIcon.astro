---
// Ícones de traço das soluções (menu e cards).
interface Props { name: "app" | "assessoria" | "educacao" | "organizacoes" }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "app" && (<><rect x="6" y="2.5" width="12" height="19" rx="3.2" /><path d="M10.5 18.3h3" /><path d="m9.2 10.6 1.9 1.9 3.7-3.9" /></>)}
  {name === "assessoria" && (<><circle cx="12" cy="7.8" r="3.6" /><path d="M4.8 20.5c.7-3.9 3.6-6 7.2-6s6.5 2.1 7.2 6" /></>)}
  {name === "educacao" && (<><path d="M2.5 9.2 12 4.6l9.5 4.6-9.5 4.6z" /><path d="M6.5 11.3v4.4c0 1.6 2.5 3.1 5.5 3.1s5.5-1.5 5.5-3.1v-4.4" /><path d="M21.5 9.2v5" /></>)}
  {name === "organizacoes" && (<><circle cx="9" cy="8.4" r="3.1" /><path d="M3.2 19.5c.6-3.2 2.9-4.9 5.8-4.9s5.2 1.7 5.8 4.9" /><circle cx="17.2" cy="9.4" r="2.4" /><path d="M16.3 14.7c2.3.2 4 1.7 4.5 4.6" /></>)}
</svg>
