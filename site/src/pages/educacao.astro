---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Faq from "@/components/Faq.astro";
import Btn from "@/components/Btn.astro";
import TeamFlag from "@/components/TeamFlag.tsx";
import { LINKS, eduFaq } from "@/data/site";

const title = "Avanti Educação · A psicologia do esporte não precisa ser solitária";
const description =
  "Comunidade para psicólogos e estudantes que querem trabalhar com atletas. Supervisão em grupo (6 a 8 participantes, quinzenal, R$ 300/mês) e individual, e cursos de extensão em breve.";

const TALLY = `https://tally.so/embed/${LINKS.tallyForm}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`;

// A roda da supervisão: 8 cadeiras em volta da mesa. A última começa como "Você".
const SEATS = 8;
const YOU = 4; // a cadeira de baixo, de frente para quem lê


const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: eduFaq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <Header
    links={[
      { label: "Comunidade", href: "#comunidade" },
      { label: "Supervisão", href: "#supervisao" },
      { label: "Cursos", href: "#cursos" },
      { label: "Metodologia", href: "#metodologia" },
    ]}
  />

  <main>
    <!-- 1. Hero: a dor, dita de frente -->
    <section class="relative pt-24 md:pt-32">
      <div class="wrap grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
        <div class="text-center lg:text-left">
          <h1 class="mx-auto max-w-[14ch] text-[clamp(2.6rem,1.3rem+3.8vw,4.6rem)] lg:mx-0">
            A psicologia não precisa ser solitária
          </h1>
          <p class="lead mx-auto mt-5 max-w-[44ch] lg:mx-0">
            A comunidade Avanti reúne psicólogos e estudantes que querem trabalhar com atletas. É por ela que vão abrir as primeiras turmas de supervisão em grupo e de cursos de extensão.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
            <Btn href="#lista" icon="arrow">Entrar na lista</Btn>
            <Btn href={LINKS.comunidade} variant="line" icon="whatsapp">Entrar na comunidade</Btn>
          </div>
        </div>

        <!-- No celular a foto sai: os dois aparecem com rosto na Metodologia. -->
        <figure class="hero-photo relative mx-auto hidden w-full max-w-[520px] lg:block">
          <img src="/img/fundadores.webp" alt="Lucas Rosito e Tiago Quevedo, fundadores da Avanti" width="1200" height="1200" fetchpriority="high" class="aspect-[5/4] w-full rounded-[32px] object-cover md:rounded-panel" />
          <figcaption>
            <span class="sticker sticker-a"><strong>Lucas Rosito</strong>25+ anos na psicologia do esporte</span>
            <span class="sticker sticker-b"><strong>Tiago Quevedo</strong>Campeão mundial de vela</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- 2. A solidão do consultório, em tipo grande -->
    <section class="pt-28 md:pt-40">
      <div class="wrap">
        <div class="alone">
          <p>Você atende sozinho.</p>
          <p>Estuda sozinho.</p>
          <p>Decide sozinho.</p>
          <p class="alone-end"><span>Não precisa ser assim.</span></p>
        </div>

        <div class="mt-12 grid gap-8 md:mt-16 md:grid-cols-2 md:gap-16">
          <p class="lead max-w-[46ch]">
            O sigilo fecha a porta do consultório, e <strong class="hl">muita gente acaba fechando junto as próprias dúvidas</strong>. Com atletas, isso pesa mais: a faculdade prepara para a clínica, mas <strong>quase não fala de performance, de bem-estar e de autoconhecimento dentro do esporte</strong>.
          </p>
          <p class="lead max-w-[46ch]">
            Foi o que mais ouvimos de <strong>psicólogos e estudantes</strong> que nos procuraram. Por isso criamos a comunidade: <strong class="hl">um lugar para pensar junto</strong>.
          </p>
        </div>
      </div>
    </section>


    <!-- 4. Supervisão: a roda -->
    <section id="supervisao" class="pt-24 md:pt-32">
      <div class="wrap grid items-center gap-12 md:grid-cols-[1fr_1fr] md:gap-16">
        <div>
          <h2 class="h2 max-w-[13ch]">Supervisão em grupo e individual</h2>
          <p class="lead mt-5 max-w-[44ch]">
            Leve os casos e os desafios do trabalho com atletas e pense neles com a metodologia da Avanti. Em grupo, numa roda de 6 a 8 pessoas a cada 15 dias. Ou individual, só você e o supervisor.
          </p>
          <div class="modes mt-8">
            <div class="mode">
              <div>
                <p class="mode-name">Em grupo</p>
                <p class="mode-note">Primeira turma em breve</p>
              </div>
              <p class="mode-price">R$ 300<small>/mês</small></p>
              <Btn href="#lista" icon="arrow">Quero a supervisão em grupo</Btn>
            </div>
            <div class="mode">
              <div>
                <p class="mode-name">Individual</p>
                <p class="mode-note">Valor e horários combinados com você</p>
              </div>
              <Btn href={LINKS.whatsappMsg("Olá! Sou da área da psicologia e quero saber mais sobre a supervisão individual da Avanti.")} variant="line" icon="whatsapp">Quero a supervisão individual</Btn>
            </div>
          </div>
        </div>

        <div class="roda-wrap">
          <div class="roda" data-roda>
            <div class="roda-table" aria-hidden="true">
              <strong>Supervisão</strong>
              <span>a cada 15 dias</span>
            </div>
            {Array.from({ length: SEATS }, (_, i) => (
              <button
                type="button"
                class:list={["seat", i === YOU && "is-you"]}
                style={`--a:${(i * 360) / SEATS}deg; --i:${i}`}
                aria-pressed={i === YOU ? "true" : "false"}
                aria-label={`Lugar ${i + 1} de ${SEATS}`}
              >
                <span class="seat-you">Você</span>
              </button>
            ))}
          </div>
          <p class="roda-caption" aria-live="polite" data-roda-caption>Uma dessas cadeiras pode ser sua. Toque para escolher.</p>
        </div>
      </div>
    </section>

    <!-- 5. Cursos de extensão: o complemento -->
    <section id="cursos" class="pt-24 md:pt-32">
      <div class="wrap">
        <div class="course">
          <div>
            <p class="course-soon">Em breve</p>
            <h2 class="course-title">Cursos de extensão</h2>
          </div>
          <p class="course-text">
            O que a graduação não costuma cobrir: performance, bem-estar e autoconhecimento dentro do esporte, com o olhar da clínica. Para psicólogos e estudantes, com a primeira turma aberta antes para a comunidade.
          </p>
          <Btn href="#lista" variant="line" icon="arrow">Quero ser avisado</Btn>
        </div>
      </div>
    </section>

    <!-- 6. Metodologia -->
    <section id="metodologia" class="pt-24 md:pt-32">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-[0.9fr_1.1fr] md:items-end md:gap-16">
          <h2 class="h2 max-w-[12ch]">A abordagem da Avanti</h2>
          <p class="lead max-w-[46ch]">Clínica aplicada ao esporte. Duas linhas que a gente leva para a realidade de quem treina e compete.</p>
        </div>

        <dl class="gloss mt-10 md:mt-14">
          <div>
            <dt>TCC</dt>
            <dd><strong>Terapia Cognitivo-Comportamental.</strong> Para trabalhar pensamentos, emoções e comportamentos que aparecem no treino, na competição e na rotina do atleta.</dd>
          </div>
          <div>
            <dt>Esquema</dt>
            <dd><strong>Terapia do Esquema.</strong> Para entender os padrões mais profundos que se repetem dentro e fora do esporte, e que pesam na hora de competir.</dd>
          </div>
        </dl>

        <div class="people mt-12 md:mt-16">
          <div class="person">
            <img class="person-photo" src="/img/lucas-rosto.webp" alt="Lucas Rosito" width="320" height="320" loading="lazy" />
            <p><strong>Lucas Rosito</strong>Psicólogo, há mais de 25 anos acompanhando atletas. Já formou medalhistas olímpicos e campeões mundiais. 2x psicólogo do Time Brasil (COB).</p>
          </div>
          <div class="person">
            <img class="person-photo" src="/img/tiago-rosto.webp" alt="Tiago Quevedo" width="320" height="320" loading="lazy" />
            <p><strong>Tiago Quevedo</strong>Ex-atleta profissional de vela, campeão mundial. Traz para a comunidade os desafios de quem vive o esporte por dentro e convida atletas para as conversas.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. A lista (formulário do Tally) -->
    <section id="lista" class="pt-24 md:pt-32">
      <div class="wrap grid gap-10 md:grid-cols-[0.85fr_1.15fr] md:gap-16">
        <div class="md:sticky md:top-28 md:self-start">
          <h2 class="h2 max-w-[13ch]">Entre na lista das primeiras turmas</h2>
          <p class="lead mt-5 max-w-[40ch]">Leva menos de um minuto. Depois, é só entrar na comunidade: as turmas abrem lá antes de todo mundo.</p>
        </div>

        <div>
          <div class="card form-card">
            <iframe data-tally-src={TALLY} loading="lazy" width="100%" height="520" frameborder="0" marginheight="0" marginwidth="0" title="Lista de interesse: supervisão e cursos de extensão"></iframe>
            <noscript><p class="p-6"><a class="link-arrow" href={`https://tally.so/r/${LINKS.tallyForm}`}>Abrir o formulário</a></p></noscript>
          </div>
          <div class="next-step" data-next hidden>
            <p><strong>Pronto, você está na lista.</strong> Agora entre na comunidade: é lá que as turmas abrem primeiro.</p>
            <Btn href={LINKS.comunidade} icon="whatsapp">Entrar na comunidade</Btn>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Chamada: a comunidade -->
    <section id="comunidade" class="pt-24 md:pt-32">
      <div class="wrap">
        <div class="relative grid items-center overflow-hidden rounded-[32px] bg-yellow md:grid-cols-[1.05fr_0.95fr] md:rounded-panel">
          <div class="relative z-10 p-8 sm:p-10 md:p-16">
            <h2 class="h2 max-w-[13ch]">Ninguém precisa fazer isso sozinho</h2>
            <p class="mt-4 max-w-[40ch] text-[17px] leading-relaxed text-ink/80">
              Entre na comunidade Avanti no WhatsApp.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <Btn href={LINKS.comunidade} icon="whatsapp">Entrar na comunidade</Btn>
              <Btn href="#lista" variant="glass">Entrar na lista</Btn>
            </div>
          </div>
          <div class="-mt-4 px-2 pb-6 md:mt-0 md:px-0 md:pb-0 md:pr-10">
            <TeamFlag client:visible kicker="comunidade" footer="psicologia do esporte" />
          </div>
        </div>

      </div>
    </section>

    <!-- 9. FAQ -->
    <section id="faq" class="pb-6 pt-24 md:pt-32">
      <div class="wrap grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
        <div class="md:sticky md:top-28 md:self-start">
          <h2 class="h2">FAQ</h2>
        </div>
        <Faq items={eduFaq} />
      </div>
    </section>

  </main>

  <Footer />
</Base>

<style is:global>

  /* Hero: a foto dos fundadores com dois adesivos */
  .hero-photo figcaption { position: absolute; inset: 0; pointer-events: none; }
  .sticker { position: absolute; display: grid; gap: 2px; padding: 12px 16px; border-radius: 18px; background: var(--color-surface); font-size: 13.5px; line-height: 1.3; color: var(--color-ink-2); box-shadow: 0 1px 2px rgb(16 24 42 / 0.08), 0 14px 30px -14px rgb(16 24 42 / 0.35); }
  .sticker strong { font-family: var(--font-display); font-size: 16px; font-weight: 650; letter-spacing: -0.02em; color: var(--color-ink); }
  .sticker-a { left: -14px; bottom: 26px; rotate: -3deg; }
  .sticker-b { right: -14px; top: 26px; rotate: 3deg; background: var(--color-yellow); color: rgb(16 24 42 / 0.75); }
  @media (max-width: 640px) {
    .sticker { font-size: 12.5px; padding: 10px 13px; }
    .sticker strong { font-size: 14.5px; }
    .sticker-a { left: -6px; bottom: -18px; }
    .sticker-b { right: -6px; top: -18px; }
  }

  /* A solidão, em tipo grande */
  .alone p { font-family: var(--font-display); font-size: clamp(2.3rem, 1.1rem + 4.6vw, 5.4rem); font-weight: 650; line-height: 1.02; letter-spacing: -0.04em; color: rgb(16 24 42 / 0.22); }
  .alone p:nth-child(2) { padding-left: 0.6em; }
  .alone p:nth-child(3) { padding-left: 1.2em; }
  .alone p.alone-end { margin-top: 0.18em; color: var(--color-ink); }
  .alone-end span { background: linear-gradient(transparent 62%, var(--color-yellow) 62%, var(--color-yellow) 92%, transparent 92%); padding: 0 0.06em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  @media (max-width: 640px) { .alone p:nth-child(2), .alone p:nth-child(3) { padding-left: 0; } }




  /* Supervisão: os dois modos, um embaixo do outro */
  .modes { display: grid; max-width: 520px; border-top: 1px solid var(--color-line); }
  .mode { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 14px 20px; padding: 22px 0; border-bottom: 1px solid var(--color-line); }
  .mode > a { grid-column: 1 / -1; justify-self: start; }
  .mode-name { font-family: var(--font-display); font-size: 21px; font-weight: 650; letter-spacing: -0.02em; }
  .mode-note { margin-top: 2px; font-size: 14.5px; color: var(--color-ink-3); }
  .mode-price { font-family: var(--font-display); font-size: 26px; font-weight: 650; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .mode-price small { margin-left: 2px; font-family: var(--font-sans); font-size: 14px; font-weight: 500; letter-spacing: 0; color: var(--color-ink-3); }
  /* Destaques no texto: negrito e um marca-texto amarelo baixo */
  .lead strong { font-weight: 650; color: var(--color-ink); }
  .hl { background: linear-gradient(transparent 64%, var(--color-yellow-soft) 64%, var(--color-yellow-soft) 94%, transparent 94%); -webkit-box-decoration-break: clone; box-decoration-break: clone; }

  /* A roda: 8 cadeiras em volta da mesa, uma é sua */
  .roda-wrap { display: grid; justify-items: center; gap: 18px; }
  .roda { position: relative; width: min(100%, 440px); aspect-ratio: 1; }
  .roda-table { position: absolute; inset: 22%; display: grid; place-content: center; text-align: center; border-radius: 50%; background: var(--color-navy); color: #fff; box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08), 0 30px 50px -30px rgb(14 26 54 / 0.7); }
  .roda-table strong { font-family: var(--font-display); font-size: clamp(1.15rem, 0.9rem + 1vw, 1.5rem); font-weight: 650; letter-spacing: -0.02em; }
  .roda-table span { margin-top: 2px; font-size: 13.5px; color: rgb(255 255 255 / 0.65); }
  .seat {
    position: absolute;
    left: calc(50% + 41.5% * sin(var(--a)) - 8.5%);
    top: calc(50% - 41.5% * cos(var(--a)) - 8.5%);
    width: 17%; aspect-ratio: 1;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 2px rgb(16 24 42 / 0.12), 0 1px 2px rgb(16 24 42 / 0.06);
    cursor: pointer; -webkit-tap-highlight-color: transparent;
    transition: background-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out), scale 380ms var(--ease-spring);
  }
  .seat::before { content: ""; width: 34%; aspect-ratio: 1; border-radius: 50%; background: rgb(16 24 42 / 0.1); transition: opacity 200ms; }
  .seat-you { position: absolute; font-size: 14px; font-weight: 700; color: var(--color-ink); opacity: 0; scale: 0.8; transition: opacity 200ms var(--ease-out), scale 380ms var(--ease-spring); }
  .seat.is-you { background: var(--color-yellow); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.45), 0 10px 22px -10px rgb(120 86 0 / 0.6); scale: 1.08; }
  .seat.is-you::before { opacity: 0; }
  .seat.is-you .seat-you { opacity: 1; scale: 1; }
  .seat:active { scale: 0.94; transition-duration: 90ms; }
  .seat:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 3px; border-radius: 50%; }
  @media (hover: hover) { .seat:not(.is-you):hover { box-shadow: inset 0 0 0 2px var(--color-yellow), 0 1px 2px rgb(16 24 42 / 0.06); } }
  /* A entrada: a mesa primeiro, as cadeiras em volta (só com JS; sem JS, tudo já aparece). */
  .js .roda:not(.is-in) .seat { scale: 0.4; opacity: 0; }
  .js .roda:not(.is-in) .roda-table { scale: 0.9; opacity: 0; }
  .js .roda .roda-table { transition: scale 600ms var(--ease-spring), opacity 300ms var(--ease-out); }
  .js .roda.is-in .seat { transition: background-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out), scale 520ms var(--ease-spring), opacity 260ms var(--ease-out); transition-delay: calc(120ms + var(--i) * 40ms), calc(120ms + var(--i) * 40ms), calc(120ms + var(--i) * 40ms), calc(120ms + var(--i) * 40ms); }
  .js .roda.is-settled .seat { transition-delay: 0s; }
  @media (prefers-reduced-motion: reduce) {
    .js .roda:not(.is-in) .seat, .js .roda:not(.is-in) .roda-table { scale: 1; }
    .seat, .seat-you, .js .roda .roda-table { transition-property: opacity, background-color, box-shadow; }
  }
  .roda-caption { min-height: 3em; max-width: 34ch; text-align: center; font-size: 15px; line-height: 1.5; color: var(--color-ink-2); }
  .roda-caption a { font-weight: 650; color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px; }

  /* Cursos: uma faixa, não mais um card */
  .course { display: grid; gap: 20px; padding: 28px 0; border-block: 1px solid var(--color-line); }
  @media (min-width: 900px) { .course { grid-template-columns: 0.8fr 1.3fr auto; align-items: center; gap: 48px; padding: 36px 0; } }
  .course-soon { display: inline-block; padding: 4px 10px; border-radius: 999px; background: var(--color-yellow-soft); font-size: 13px; font-weight: 650; }
  .course-title { margin-top: 10px; font-size: clamp(1.7rem, 1.35rem + 1vw, 2.3rem); }
  .course-text { max-width: 54ch; color: var(--color-ink-2); }

  /* Metodologia: glossário */
  .gloss { border-top: 1px solid var(--color-line); }
  .gloss > div { display: grid; gap: 8px; padding: 26px 0; border-bottom: 1px solid var(--color-line); }
  @media (min-width: 768px) { .gloss > div { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 64px; align-items: center; padding: 34px 0; } }
  .gloss dt { font-family: var(--font-display); font-size: clamp(2.6rem, 1.6rem + 3.4vw, 4.6rem); font-weight: 650; line-height: 1; letter-spacing: -0.04em; }
  .gloss dd { max-width: 48ch; font-size: 17px; line-height: 1.6; color: var(--color-ink-2); }
  .gloss dd strong { color: var(--color-ink); font-weight: 650; }
  .people { display: grid; gap: 28px; }
  @media (min-width: 768px) { .people { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; } }
  .person { display: flex; align-items: flex-start; gap: 18px; }
  .person p { font-size: 15.5px; line-height: 1.55; color: var(--color-ink-2); }
  .person p strong { display: block; margin-bottom: 4px; font-family: var(--font-display); font-size: 20px; font-weight: 650; letter-spacing: -0.02em; color: var(--color-ink); }
  .person-photo { width: 96px; height: 96px; flex: none; border-radius: 50%; object-fit: cover; background: var(--color-navy); }

  /* Lista */
  .form-card { padding: 22px 18px 10px; }
  @media (min-width: 768px) { .form-card { padding: 30px 30px 14px; } }
  .form-card iframe { display: block; min-height: 420px; }
  .next-step { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-top: 14px; padding: 20px 22px; border-radius: 22px; background: var(--color-yellow); animation: pop 520ms var(--ease-spring); }
  .next-step[hidden] { display: none; }
  .next-step p { max-width: 36ch; font-size: 15.5px; line-height: 1.45; }
  @keyframes pop { from { opacity: 0; translate: 0 10px; scale: 0.98; } }

</style>

<script>
  // A roda: entra quando aparece; tocar numa cadeira faz dela a sua.
  const roda = document.querySelector<HTMLElement>("[data-roda]");
  const caption = document.querySelector<HTMLElement>("[data-roda-caption]");
  if (roda) {
    const io = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      io.disconnect();
      roda.classList.add("is-in");
      setTimeout(() => roda.classList.add("is-settled"), 1200);
    }, { threshold: 0.3 });
    io.observe(roda);

    const seats = [...roda.querySelectorAll<HTMLButtonElement>(".seat")];
    seats.forEach((s) =>
      s.addEventListener("click", () => {
        if (s.classList.contains("is-you")) return;
        seats.forEach((o) => { o.classList.remove("is-you"); o.setAttribute("aria-pressed", "false"); });
        s.classList.add("is-you");
        s.setAttribute("aria-pressed", "true");
        if (caption) caption.innerHTML = 'Esse lugar é seu. <a href="#lista">Entre na lista</a> para garantir a primeira turma.';
      })
    );
  }

  // Formulário do Tally: carrega perto da tela e, ao enviar, mostra o convite para a comunidade.
  const frame = document.querySelector<HTMLIFrameElement>("iframe[data-tally-src]");
  if (frame) {
    const load = () => {
      const w = window as unknown as { Tally?: { loadEmbeds: () => void } };
      if (w.Tally) return w.Tally.loadEmbeds();
      const s = document.createElement("script");
      s.src = "https://tally.so/widgets/embed.js";
      s.onload = () => w.Tally?.loadEmbeds();
      s.onerror = () => { frame.src = frame.dataset.tallySrc!; };
      document.body.appendChild(s);
    };
    const near = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { near.disconnect(); load(); } }, { rootMargin: "600px" });
    near.observe(frame);

    const next = document.querySelector<HTMLElement>("[data-next]");
    window.addEventListener("message", (e) => {
      if (e.origin !== "https://tally.so" || typeof e.data !== "string" || !e.data.includes("Tally.FormSubmitted")) return;
      if (next) { next.hidden = false; next.scrollIntoView({ behavior: "smooth", block: "center" }); }
    });
  }
</script>
