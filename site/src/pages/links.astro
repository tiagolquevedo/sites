---
import Base from "@/layouts/Base.astro";
import Perfil from "@/components/links/Perfil.astro";
import Basica from "@/components/links/Basica.astro";
import Stories from "@/components/links/Stories.astro";
import Conversa from "@/components/links/Conversa.astro";
import Cartas from "@/components/links/Cartas.astro";
import { DEFAULT_VARIANT, VARIANTS, UTM } from "@/data/links";

const title = "Avanti · Links";
const description = "App, assessoria, educação e organizações: escolha por onde começar na Avanti.";
---
<Base title={title} description={description} path="/links" noindex>
  <!-- Escolhe a variante antes de pintar: ?v=stories | conversa | cartas | basica -->
  <script is:inline define:vars={{ DEFAULT_VARIANT, VARIANTS }}>
    (function () {
      var v = new URLSearchParams(location.search).get("v");
      document.documentElement.dataset.variant = VARIANTS.indexOf(v) > -1 ? v : DEFAULT_VARIANT;
    })();
  </script>
  <noscript><style>[data-v="basica"]{display:flex !important}</style></noscript>

  <Perfil />
  <Basica />
  <Stories />
  <Conversa />
  <Cartas />

  <script is:inline define:vars={{ UTM }}>
    // Mede o clique (variante + destino) e marca as URLs internas para separar o tráfego da bio.
    document.addEventListener("click", function (e) {
      var a = e.target.closest && e.target.closest("a[data-go]");
      if (!a) return;
      var variant = document.documentElement.dataset.variant;
      var dest = a.dataset.go;
      try {
        var u = new URL(a.getAttribute("href"), location.href);
        if (u.origin === location.origin || /(^|\.)avantiperformance\.com\.br$/.test(u.hostname)) {
          u.searchParams.set("utm_source", UTM.source);
          u.searchParams.set("utm_medium", UTM.medium);
          u.searchParams.set("utm_campaign", "bio-" + variant);
          a.href = u.href;
        }
      } catch (_) {}
      var data = { variant: variant, dest: dest };
      try {
        if (window.plausible) window.plausible("link_bio", { props: data });
        if (window.gtag) window.gtag("event", "link_bio", data);
        if (window.dataLayer) window.dataLayer.push(Object.assign({ event: "link_bio" }, data));
      } catch (_) {}
    }, true);
  </script>
</Base>

<style is:global>
  /* Só a variante ativa aparece. */
  [data-v] { display: none; }
  html[data-variant="perfil"] [data-v="perfil"],
  html[data-variant="basica"] [data-v="basica"],
  html[data-variant="stories"] [data-v="stories"],
  html[data-variant="cartas"] [data-v="cartas"] { display: flex; }
  html[data-variant="stories"] [data-v="stories"] { display: block; }
  html[data-variant="conversa"] [data-v="conversa"] { display: flex; }
  html[data-variant="stories"] body { background: var(--color-navy); }
  html, body { overscroll-behavior-y: none; }
</style>
