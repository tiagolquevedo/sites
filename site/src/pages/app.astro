  /* Avisos do algoritmo sobre o celular do hero */
  .hero-stage { padding-bottom: 0; overflow: hidden; border-radius: 0 0 36px 36px; }
  .alerts { position: absolute; left: 50%; top: 22%; width: min(92%, 380px); translate: -50% 0; height: 96px; }
  .alert {
    position: absolute; inset: 0 0 auto; display: flex; align-items: center; gap: 12px; width: 100%;
    padding: 13px 14px; border-radius: 22px; text-align: left; cursor: pointer;
