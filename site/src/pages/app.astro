---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Faq from "@/components/Faq.astro";
import Btn from "@/components/Btn.astro";
import Check from "@/components/Check.astro";
import TeamFlag from "@/components/TeamFlag.tsx";
import CheckoutFly from "@/components/CheckoutFly.tsx";
import { LINKS, PRICE, testimonials, appFaq, APP_INCLUDED as included } from "@/data/site";

const title = "App Avanti · A preparação mental dos melhores atletas do mundo";
const description =
  "Autoconhecimento e dados para atletas: report diário, Mental Score, algoritmo de alertas, avaliações psicológicas, campeonatos e metas e os cursos do método Avanti. R$ 30/mês ou R$ 249/ano.";

const ph = (name: string) => `/app/${name}-440.webp`;
const PH_W = 440;
const PH_H = 915;

// Exemplos de avisos do algoritmo (o primeiro é texto real do app).
const alerts = [
  { t: "Dia acima do seu padrão!", d: "Você parece estar em um ótimo momento. Continue cuidando de si." },
  { t: "Seu sono caiu nos últimos 3 dias", d: "Vale priorizar o descanso nesta reta antes do campeonato." },
  { t: "Faltam 5 dias para o seu campeonato", d: "Revise as suas metas e o seu plano para a competição." },
  { t: "Ansiedade acima do seu normal", d: "Separamos uma aula sobre como lidar com a pressão." },
];

const steps = [
  { img: "app-report-bem-estar", t: "Registre o seu dia", d: "Os melhores atletas do mundo fazem journaling, e agora você também pode fazer. Em 2 minutos, anote treino, sono, humor, energia e emoções. A rotina dos melhores atletas do mundo, no seu bolso." },
  { img: "app-dados-mental-score", t: "Enxergue os seus padrões", d: "O app aprende como você funciona e transforma a sua rotina em Mental Score, calendário e relatórios mensais." },
  { img: "app-report-resumo", t: "Receba alertas e feedback", d: "O algoritmo acompanha o seu bem-estar dentro dos seus próprios padrões e avisa quando algo foge do normal." },
  { img: "app-metas", t: "Prepare os seus campeonatos", d: "Defina metas, planeje e avalie cada competição. Tudo vira contexto para o próximo passo." },
  { img: "app-compartilhar-semana", t: "Compartilhe a sua evolução", d: "O seu dia e a sua semana viram um card pronto para o story e para a comunidade Avanti. Quem te acompanha vê a sua constância e se inspira junto." },
];


const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "Avanti",
    operatingSystem: "iOS, Android",
    applicationCategory: "HealthApplication",
    description,
    offers: [
      { "@type": "Offer", price: "30.00", priceCurrency: "BRL", name: "Plano mensal" },
      { "@type": "Offer", price: "249.00", priceCurrency: "BRL", name: "Plano anual" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: appFaq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Base title={title} description={description} path="/app" jsonLd={jsonLd}>
  <Header
    links={[
      { label: "Como funciona", href: "#como-funciona" },
      { label: "Recursos", href: "#recursos" },
      { label: "Planos", href: "#planos" },
      { label: "Perguntas", href: "#faq" },
    ]}
    cta="#planos"
  />

  <main>
    <!-- 1. Hero -->
    <section class="relative pt-24 md:pt-32">
      <div class="wrap grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-8">
        <div class="text-center lg:text-left">
        <a href="#depoimentos" class="pill inline-flex items-center gap-3 rounded-full border border-line bg-surface py-1.5 pl-1.5 pr-4 text-[14px] font-medium text-ink-2">
          <span class="flex -space-x-2">
            {testimonials.slice(0, 3).map((t) => (
              <img src={t.photo} alt="" width="28" height="28" class="size-7 rounded-full border-2 border-surface object-cover" />
            ))}
          </span>
          <span><strong class="font-semibold text-ink">1.000+ atletas</strong> impactados</span>
        </a>
        <h1 class="mx-auto mt-6 max-w-[21ch] text-[clamp(2.2rem,1.2rem+2.6vw,3.55rem)] lg:mx-0">
          A preparação mental dos melhores atletas do mundo, agora disponível para você
        </h1>
        <p class="lead mx-auto mt-5 max-w-[46ch] lg:mx-0">
          Do amador ao profissional, unimos ciência, tecnologia e dados para a sua preparação mental ser feita sob medida.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
          <Btn href="#planos" avanti />
          <Btn href="#como-funciona" variant="line">Como funciona</Btn>
        </div>
        <p class="mt-5 text-[14px] text-ink-3">7 dias de garantia, no iPhone e no Android</p>
        </div>

        <!-- O app avisando: a coisa viva da página -->
        <div class="hero-stage relative mx-auto w-full max-w-[520px]">
          <div class="absolute inset-x-0 bottom-0 top-[18%] rounded-[36px]  bg-yellow" aria-hidden="true"></div>
          <img src="/app/app-home-vela-720.webp" alt="Tela inicial do app Avanti" width="720" height="1497" fetchpriority="high" class="relative mx-auto w-[62%] max-w-[300px] translate-y-6 drop-shadow-[0_24px_30px_rgb(16_24_42_/_0.18)]" />
          <div class="alerts" data-alerts aria-live="polite">
            {alerts.map((a, i) => (
              <button type="button" class:list={["alert", i === 0 && "is-on"]} data-i={i} aria-label={`${a.t}. Próximo aviso`}>
                <span class="alert-icon" aria-hidden="true"><img src="/logo-yellow.png" alt="" width="480" height="84" /></span>
                <span class="min-w-0 text-left">
                  <span class="alert-meta">Avanti · agora</span>
                  <span class="alert-title">{a.t}</span>
                  <span class="alert-desc">{a.d}</span>
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. A dor -->
    <section class="pt-24 md:pt-36">
      <div class="wrap">
        <h2 class="h2 max-w-[30ch]">Você treina bem. Tem repertório. Só não sabe como destravar isso na hora do campeonato.</h2>
        <p class="lead mt-5 max-w-[56ch]">Todo atleta reconhece isso, mas poucos conhecem os padrões psicológicos que derrubam o desempenho na hora da competição.</p>

        <div class="pains mt-10 grid gap-4 md:mt-14 md:grid-cols-3 md:gap-5">
          <article class="card pain">
            <svg viewBox="0 0 240 110" class="pain-chart" aria-hidden="true">
              <line x1="0" y1="100" x2="240" y2="100" class="axis" />
              <rect x="34" y="18" width="62" height="82" rx="10" class="bar-good" />
              <rect x="144" y="64" width="62" height="36" rx="10" class="bar-bad" />
              <text x="65" y="12" class="lbl">treino</text>
              <text x="175" y="56" class="lbl">competição</text>
            </svg>
            <h3>Você treina bem, mas compete mal</h3>
            <p>O cenário muda e você também. A confiança cai e leva junto meses de preparação.</p>
          </article>
          <article class="card pain">
            <svg viewBox="0 0 240 110" class="pain-chart" aria-hidden="true">
              <line x1="0" y1="100" x2="240" y2="100" class="axis" />
              <path d="M6 40 C 50 34, 90 30, 132 32 S 150 88, 176 90 S 220 84, 234 86" class="line-bad" />
              <circle cx="150" cy="58" r="5" class="dot" />
              <text x="160" y="22" class="lbl">a pressão chega</text>
            </svg>
            <h3>A pressão chega e você some</h3>
            <p>Parece que você esqueceu como competir. O que ia bem no treino não sai na hora que importa.</p>
          </article>
          <article class="card pain">
            <svg viewBox="0 0 240 110" class="pain-chart" aria-hidden="true">
              <line x1="0" y1="100" x2="240" y2="100" class="axis" />
              <path d="M6 70 L 36 26 L 66 80 L 96 34 L 126 88 L 156 22 L 186 76 L 216 40 L 234 62" class="line-bad" />
            </svg>
            <h3>Às vezes vai bem, mas falta constância</h3>
            <p>Bons resultados vêm de consistência, e consistência começa pela mente.</p>
          </article>
        </div>

        <div class="nope mt-12 rounded-card bg-surface p-7 md:mt-14 md:p-10" style="box-shadow:0 0 0 1px rgb(16 24 42 / 0.06)">
          <div class="grid items-center gap-7 md:grid-cols-12">
            <p class="font-display text-[clamp(1.4rem,1.1rem+1vw,2rem)] font-semibold leading-tight tracking-[-0.02em] md:col-span-5">Cansamos de protocolos genéricos. Por isso, criamos algo diferente.</p>
            <ul class="flex flex-wrap gap-2.5 md:col-span-7 md:justify-end">
              <li class="nope-chip">gurus e promessas milagrosas</li>
              <li class="nope-chip">receitas prontas feitas com IA</li>
              <li class="nope-chip">dicas e frases bonitas</li>
              <li class="nope-chip">resultados rápidos e permanentes</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. O método (Educação) -->
    <section id="metodo" class="pt-24 md:pt-32">
      <div class="wrap">
        <div class="relative overflow-hidden rounded-[32px] border border-[#f1dc8a] bg-yellow-soft md:rounded-panel">
          <div class="grid items-center md:grid-cols-12">
            <div class="relative z-10 p-8 sm:p-10 md:col-span-7 md:p-14">
              <p class="text-[15px] font-semibold text-ink-2">Avanti Academy</p>
              <h2 class="h2 mt-2 max-w-[17ch]">Aprenda o método que formou campeões</h2>
              <p class="lead mt-5 max-w-[48ch]">O mesmo modelo mental que já formou campeões mundiais, brasileiros, medalhistas olímpicos e pan-americanos, agora preparando a sua mente.</p>
              <ul class="mt-7 space-y-3 text-[16px]">
                <li class="flex gap-3"><Check />Aulas curtas sobre foco, ansiedade, pressão e emoções</li>
                <li class="flex gap-3"><Check />Uma trilha feita para o seu perfil e o seu esporte</li>
                <li class="flex gap-3"><Check />Neurociência aplicada ao que você vive no treino e na competição</li>
              </ul>
              <div class="mt-9">
                <Btn href="#planos" avanti />
              </div>
            </div>
            <div class="relative flex justify-center pb-0 md:col-span-5 md:h-full md:items-end">
              <div class="courses" aria-hidden="true">
                <span>Lidando com a pressão</span>
                <span>Neurociência da mente cognitiva</span>
                <span>Autocrítica e sabotagem</span>
              </div>
              <img src={ph("app-academy")} alt="Cursos da Avanti Academy dentro do app" width={PH_W} height={PH_H} loading="lazy" class="phone relative -mb-28 w-[58%] max-w-[260px] rotate-[3deg] md:-mb-24 md:mr-6 md:w-[70%]" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Como funciona (o momento coreografado) -->
    <section id="como-funciona" class="pt-24 md:pt-32">
      <div class="wrap">
        <div class="grid gap-5 md:grid-cols-12 md:items-end">
          <h2 class="h2 md:col-span-7">Autoconhecimento que vira dados</h2>
          <p class="lead md:col-span-5">Um app que aprende os seus padrões e acompanha os seus estados mentais para cuidar de você e da sua evolução.</p>
        </div>

        <div class="steps mt-10 grid gap-10 md:mt-16 lg:grid-cols-2 lg:gap-16" data-steps>
          <ol class="flex flex-col gap-6 lg:gap-0">
            {steps.map((s, i) => (
              <li class:list={["step", i === 0 && "is-on"]} data-step={i}>
                <span class="step-n" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3 class="text-[clamp(1.4rem,1.15rem+0.8vw,1.9rem)]">{s.t}</h3>
                  <p class="mt-2 max-w-[44ch] text-ink-2">{s.d}</p>
                  <img src={ph(s.img)} alt="" width={PH_W} height={PH_H} loading="lazy" class="phone mx-auto mt-6 w-[72%] max-w-[230px] lg:hidden" />
                </div>
              </li>
            ))}
          </ol>
          <div class="hidden lg:block">
            <div class="steps-stage">
              <div class="absolute inset-x-6 bottom-10 top-24 rounded-[36px] bg-yellow-soft" aria-hidden="true"></div>
              {steps.map((s, i) => (
                <img class:list={["phone steps-img", i === 0 && "is-on"]} src={ph(s.img)} alt={s.t} width={PH_W} height={PH_H} loading="lazy" />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Recursos -->
    <section id="recursos" class="pt-24 md:pt-32">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-12 md:items-end">
          <h2 class="h2 max-w-[18ch] md:col-span-7">Um ecossistema de preparação mental na palma da mão</h2>
          <div class="md:col-span-5 md:flex md:justify-end">
            <Btn href="#planos" avanti />
          </div>
        </div>

        <div class="tiles mt-10 grid gap-4 md:mt-14 md:grid-cols-12 md:gap-5">
          <article class="tile border border-[#f1dc8a] bg-yellow-soft md:col-span-7">
            <div class="tile-text">
              <h3 class="tile-title">Avaliações psicológicas</h3>
              <p>A avaliação de perfil de atleta mapeia os seus padrões e mostra onde focar.</p>
            </div>
            <div class="duo">
              <img class="phone" src={ph("app-avaliacao-perfil")} alt="Início da avaliação de perfil de atleta" width={PH_W} height={PH_H} loading="lazy" />
              <img class="phone" src={ph("app-avaliacao-resultado")} alt="Resultado da avaliação com os padrões do atleta" width={PH_W} height={PH_H} loading="lazy" />
            </div>
          </article>

          <article class="tile tile-dark bg-navy text-white md:col-span-5">
            <div class="tile-text">
              <h3 class="tile-title">Airton, a IA que te conhece</h3>
              <p>Peça para ele avaliar seus dados, criar campeonatos, enxergar padrões e sugerir conteúdos.</p>
            </div>
            <div class="solo">
              <img class="phone" src={ph("app-airton-chat")} alt="Conversa com o Airton, assistente com IA" width={PH_W} height={PH_H} loading="lazy" />
            </div>
          </article>

          <article class="tile card md:col-span-5">
            <div class="tile-text">
              <h3 class="tile-title">Comunidade Avanti</h3>
              <p>Consistência é mais fácil quando você não está sozinho. Siga atletas, compartilhe treinos e suba de nível.</p>
            </div>
            <div class="solo">
              <img class="phone" src={ph("app-comunidade")} alt="Feed da comunidade com atletas subindo de nível" width={PH_W} height={PH_H} loading="lazy" />
            </div>
          </article>

          <div class="flex flex-col gap-4 md:col-span-7 md:gap-5 max-md:contents">
            <article class="tile card mini">
              <div class="tile-text">
                <h3 class="tile-title">Feito para você, não para todo mundo</h3>
                <p>O app cruza a sua avaliação, os seus reports e os seus campeonatos e recomenda o que estudar em seguida.</p>
              </div>
              <div class="mock" aria-hidden="true">
                <ul class="mock-src">
                  <li><span class="mock-ok"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 8.4 2.6 2.6L12 5.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>Sua avaliação de perfil</span><em>autocrítica alta</em></li>
                  <li><span class="mock-ok"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 8.4 2.6 2.6L12 5.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>Seus últimos reports</span><em>sono abaixo do normal</em></li>
                  <li><span class="mock-ok"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 8.4 2.6 2.6L12 5.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>Seu próximo campeonato</span><em>em 12 dias</em></li>
                </ul>
                <div class="mock-rec">
                  <span class="mock-play"><svg viewBox="0 0 16 16"><path d="M5.5 3.8v8.4L12 8z" fill="currentColor"/></svg></span>
                  <span class="min-w-0"><small>Para você hoje</small><strong>Autocrítica e sabotagem</strong></span>
                  <span class="mock-time">aula · 6 min</span>
                </div>
              </div>
            </article>
            <article class="tile card mini">
              <div class="tile-text">
                <h3 class="tile-title">Seu psicólogo e seu treinador na mesma página</h3>
                <p>Conecte quem te acompanha e eles enxergam os seus dados para te ajudar melhor. Você escolhe quem vê e o quê.</p>
              </div>
              <div class="mock">
                <p class="mock-label">Quem vê os seus dados</p>
                <button type="button" class="share" role="switch" aria-checked="true">
                  <span class="share-av">P</span>
                  <span class="min-w-0"><strong>Seu psicólogo</strong><small>Reports, Mental Score e avaliações</small></span>
                  <span class="toggle" aria-hidden="true"></span>
                </button>
                <button type="button" class="share" role="switch" aria-checked="true">
                  <span class="share-av">T</span>
                  <span class="min-w-0"><strong>Seu treinador</strong><small>Treinos, metas e campeonatos</small></span>
                  <span class="toggle" aria-hidden="true"></span>
                </button>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- Time Avanti: a bandeira (Cloth Banner do MyUI) -->
    <section class="pt-24 md:pt-32">
      <div class="wrap grid items-center gap-6 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-5">
          <h2 class="h2 max-w-[14ch]">Você não treina sozinho</h2>
          <p class="lead mt-5 max-w-[42ch]">Quem assina entra para o time Avanti: atletas do amador ao profissional que registram o dia, compartilham treinos e sobem de nível juntos.</p>
          <div class="mt-8"><Btn href="#planos" avanti /></div>
        </div>
        <div class="-mx-5 md:col-span-7 md:mx-0">
          <TeamFlag client:visible />
          <p class="mt-1 text-center text-[13px] text-ink-3">Puxe a bandeira.</p>
        </div>
      </div>
    </section>

    <!-- 6. Depoimentos: os atletas de referência, com foto grande -->
    <section id="depoimentos" class="pt-24 md:pt-32">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-12 md:items-end">
          <h2 class="h2 md:col-span-7">Quem usa, aprova</h2>
          <p class="lead md:col-span-5">Atletas de ponta e um treinador olímpico que já usam a Avanti na rotina.</p>
        </div>
        <div class="athletes mt-10 md:mt-14" data-athletes>
          {testimonials.map((t) => {
            const [sport, feat] = t.role.split(" · ");
            return (
              <figure class="athlete">
                <div class="athlete-photo">
                  <img src={t.portrait} alt={`${t.name}, ${t.role}`} width="560" height="700" loading="lazy" />
                </div>
                <blockquote>“{t.quote}”</blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  <span>{sport}</span>
                  <em class="athlete-feat">{feat}</em>
                </figcaption>
              </figure>
            );
          })}
        </div>
        <div class="athlete-dots" data-dots aria-hidden="true">
          {testimonials.map((_, i) => <span class:list={[i === 0 && "is-on"]}></span>)}
        </div>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <Btn href="#planos" avanti />
          <Btn href={LINKS.testimonialsApp} variant="line">Ver todos os depoimentos do app</Btn>
        </div>
      </div>
    </section>

    <!-- 7. Planos (o cartão "Membership Avanti" do site atual) -->
    <section id="planos" class="pt-24 md:pt-32">
      <div class="wrap">
        <div class="text-center">
          <h2 class="h2 mx-auto max-w-[24ch]">Escolha o seu plano e entre para o time de atletas da Avanti</h2>
        </div>

        <article class="member mx-auto mt-10 max-w-[600px] md:mt-14" data-checkout data-sel="year" data-href-year={LINKS.checkoutYearly} data-href-month={LINKS.checkoutMonthly}>
          <div class="member-ribbon" aria-hidden="true"><span><img src="/logo-navy.png" alt="" width="480" height="84" /></span></div>
          <h3 class="member-title">Membership Avanti</h3>

          <div class="member-row">
            <div class="member-price">
              <p class="if-year"><span>{PRICE.year}</span> / ano</p>
              <p class="if-month"><span>{PRICE.month}</span> / mês</p>
            </div>
            <div class="member-switch">
              <span class="member-opt" data-for="month">Mensal</span>
              <button type="button" class="member-toggle" role="switch" aria-checked="true" aria-label="Plano anual"><span></span></button>
              <span class="member-opt" data-for="year">Anual</span>
            </div>
          </div>
          <div class="member-save">
            <p class="if-year">Economize R$ 111 (31%) com a assinatura anual</p>
            <p class="if-month">Cancele quando quiser, sem multa</p>
          </div>

          <p class="member-incl">O que está incluso:</p>
          <ul class="member-list">
            {included.map((it) => (
              <li>
                <span class="member-check" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="#10182a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                {it}
              </li>
            ))}
          </ul>

          <CheckoutFly client:visible href={LINKS.checkoutYearly} height={220} />
          <p class="member-note"><strong>7 dias de garantia.</strong> Se não gostar, cancele e não cobramos nada.</p>
        </article>
      </div>
    </section>

    <!-- 8. FAQ -->
    <section id="faq" class="pt-24 md:pt-32">
      <div class="wrap grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
        <div class="md:sticky md:top-28 md:self-start">
          <h2 class="h2">Perguntas sobre o app</h2>
          <p class="lead mt-4 max-w-[34ch]">Ficou alguma dúvida? Chama o fundador no WhatsApp.</p>
          <Btn href={LINKS.whatsappMsg("Olá! Tenho uma dúvida sobre o app Avanti.")} variant="line" icon="whatsapp" class="mt-7">Fale com o fundador</Btn>
        </div>
