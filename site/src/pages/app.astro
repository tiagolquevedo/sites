  .athlete-photo::after { content: ""; position: absolute; inset: auto 0 0; height: 45%; background: linear-gradient(transparent, var(--color-navy)); }
  .athlete figcaption .athlete-feat { display: inline-flex; margin-top: 12px; padding: 6px 12px; border-radius: 999px; background: var(--color-yellow); color: var(--color-ink); font-size: 13px; font-weight: 650; font-style: normal; }
  .athlete blockquote { position: relative; z-index: 1; margin-top: -34px; padding: 0 22px; font-size: 15.5px; line-height: 1.5; font-weight: 500; }
  .athlete figcaption { margin: auto 22px 0; padding: 18px 0 22px; border-top: 1px solid rgb(255 255 255 / 0.14); margin-top: 18px; }
  .athlete figcaption strong { display: block; font-family: var(--font-display); font-size: 18px; font-weight: 650; letter-spacing: -0.01em; }
  .athlete figcaption span { display: block; margin-top: 2px; font-size: 14px; color: var(--color-yellow); }
  @media (hover: hover) { .athlete:hover .athlete-photo img { scale: 1.04; } }
  .athlete-dots { display: none; }
  /* No celular: carrossel que anda sozinho e dá para arrastar com o dedo. */
  @media (max-width: 639px) {
    .athletes { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 20px; margin-inline: -20px; padding: 0 20px 4px; scrollbar-width: none; }
    .athletes::-webkit-scrollbar { display: none; }
    .athlete { flex: none; width: 80%; scroll-snap-align: start; }
    .athlete-dots { display: flex; justify-content: center; gap: 6px; margin-top: 16px; }
    .athlete-dots span { width: 7px; height: 7px; border-radius: 99px; background: var(--color-line); transition: width 300ms var(--ease-out), background-color 300ms; }
    .athlete-dots span.is-on { width: 22px; background: var(--color-ink); }
  }

  /* Depoimentos */

  /* Planos: cartão "Membership Avanti" */
