<script>
  // Carrossel dos atletas no celular: avança sozinho; o dedo pausa.
  {
    const row = document.querySelector<HTMLElement>("[data-athletes]");
    const dots = [...document.querySelectorAll<HTMLElement>("[data-dots] span")];
    if (row) {
      const cards = [...row.children] as HTMLElement[];
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const mobile = matchMedia("(max-width: 639px)");
      let visible = false, holdUntil = 0;
      new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.5 }).observe(row);
      const current = () => Math.round(row.scrollLeft / (cards[1].offsetLeft - cards[0].offsetLeft));
      row.addEventListener("scroll", () => { const i = current(); dots.forEach((d, k) => d.classList.toggle("is-on", k === i)); }, { passive: true });
      row.addEventListener("touchstart", () => (holdUntil = performance.now() + 6000), { passive: true });
      setInterval(() => {
        if (still || !mobile.matches || !visible || document.hidden || performance.now() < holdUntil) return;
        const next = (current() + 1) % cards.length;
        row.scrollTo({ left: cards[next].offsetLeft - cards[0].offsetLeft, behavior: "smooth" });
      }, 4200);
    }
  }

  // Cartão de planos: chave Mensal/Anual (tocar no nome também troca).
  document.querySelectorAll<HTMLElement>("[data-checkout]").forEach((card) => {
    const sw = card.querySelector<HTMLButtonElement>(".member-toggle");
    if (!sw) return;
    const set = (year: boolean) => {
      card.dataset.sel = year ? "year" : "month";
      sw.setAttribute("aria-checked", String(year));
      sw.setAttribute("aria-label", year ? "Plano anual" : "Plano mensal");
    };
    sw.addEventListener("click", () => set(card.dataset.sel !== "year"));
    card.querySelectorAll<HTMLElement>(".member-opt").forEach((o) => o.addEventListener("click", () => set(o.dataset.for === "year")));
  });

  document.querySelectorAll<HTMLButtonElement>(".share").forEach((b) =>
    b.addEventListener("click", () => b.setAttribute("aria-checked", String(b.getAttribute("aria-checked") !== "true")))
  );

  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Avisos do hero: um por vez; tocar mostra o próximo.
  const box = document.querySelector<HTMLElement>("[data-alerts]");
  if (box) {
    const items = [...box.querySelectorAll<HTMLElement>(".alert")];
    let i = 0, timer = 0, visible = true;
    const show = (n: number) => {
      const cur = items[i];
      cur.classList.remove("is-on");
      cur.classList.add("is-out");
      setTimeout(() => cur.classList.remove("is-out"), 360);
      i = n % items.length;
      items[i].classList.add("is-on");
    };
    const loop = () => { clearInterval(timer); if (!still) timer = window.setInterval(() => { if (visible && !document.hidden) show(i + 1); }, 5200); };
    items.forEach((el) => el.addEventListener("click", () => { show(i + 1); loop(); }));
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(box);
    loop();
  }

  // Como funciona: o passo no meio da tela troca a tela do celular.
  const wrap = document.querySelector<HTMLElement>("[data-steps]");
  if (wrap) {
    const steps = [...wrap.querySelectorAll<HTMLElement>(".step")];
    const imgs = [...wrap.querySelectorAll<HTMLElement>(".steps-img")];
    const set = (n: number) => {
      steps.forEach((s, k) => s.classList.toggle("is-on", k === n));
      imgs.forEach((s, k) => s.classList.toggle("is-on", k === n));
    };
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) set(Number((e.target as HTMLElement).dataset.step)); }), { rootMargin: "-45% 0px -45% 0px" });
    steps.forEach((s) => io.observe(s));
  }

  // Quem chega por #planos (ex.: link da bio) tem de cair na seção de preço: as imagens acima
  // carregam depois e empurram a página, então reposiciona quando tudo terminou de carregar.
  // Só corrige se a seção de fato saiu do lugar (e a pessoa ainda não rolou), para não dar "pulinho".
  if (location.hash === "#planos") {
    const el = document.getElementById("planos");
    const top = () => (el ? el.getBoundingClientRect().top : 0);
    const want = () => parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
    let touched = false;
    ["wheel", "touchstart", "keydown"].forEach((ev) => addEventListener(ev, () => (touched = true), { once: true, passive: true }));
    const fix = () => { if (el && !touched && Math.abs(top() - want()) > 8) el.scrollIntoView({ behavior: "instant" as ScrollBehavior, block: "start" }); };
    window.addEventListener("load", () => requestAnimationFrame(fix), { once: true });
  }
</script>
