  .toggle { position: relative; margin-left: auto; width: 44px; height: 26px; border-radius: 999px; background: var(--color-line); flex: none; transition: background-color 220ms; }
  .toggle::after { content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 999px; background: #fff; box-shadow: 0 1px 3px rgb(16 24 42 / 0.25); transition: translate 420ms var(--ease-spring); }
  .share[aria-checked="true"] .toggle { background: var(--color-yellow); }
  .share[aria-checked="true"] .toggle::after { translate: 18px 0; }

