  .member-toggle:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 3px; }
  .member-save { display: grid; min-height: 20px; margin-top: 8px; font-size: 13.5px; font-weight: 600; color: #0f8a5f; }
  .member-price > p, .member-save > p { grid-area: 1 / 1; }
  .member .if-year, .member .if-month { transition: opacity 240ms var(--ease-out), translate 380ms var(--ease-spring), visibility 0s 240ms; }
  .member[data-sel="year"] .if-year, .member[data-sel="month"] .if-month { transition-delay: 0s; }
  .member[data-sel="year"] .if-month, .member[data-sel="month"] .if-year { opacity: 0; translate: 0 6px; visibility: hidden; }
  .member-incl { margin-top: 18px; font-size: 13px; font-weight: 700; color: rgb(16 24 42 / 0.55); }
