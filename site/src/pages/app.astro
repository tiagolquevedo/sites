  .member-switch { display: flex; align-items: center; gap: 8px; padding-bottom: 6px; font-size: 13px; }
  .member-opt { color: rgb(16 24 42 / 0.5); cursor: pointer; transition: color 200ms; }
  .member[data-sel="year"] .member-opt[data-for="year"], .member[data-sel="month"] .member-opt[data-for="month"] { color: var(--color-ink); font-weight: 650; }
  .member-toggle { position: relative; width: 44px; height: 24px; flex: none; border-radius: 12px; background: rgb(16 24 42 / 0.15); transition: background-color 250ms; cursor: pointer; }
  .member-toggle span { position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / 0.3); transition: translate 320ms var(--ease-spring); }
  .member-toggle[aria-checked="true"] { background: var(--color-yellow); }
