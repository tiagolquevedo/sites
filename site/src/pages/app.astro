  /* O palco do botão sobe por trás da lista: o botão fica no lugar do CTA e decola por cima. */
  .member .checkout-fly { position: relative; z-index: 1; margin: -118px -28px 0; }
  @media (max-width: 640px) { .member .checkout-fly { margin: -118px -18px 0; } }
